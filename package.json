{
    "private": true,
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "build:sdk": "npm run build --workspace=@cmd-hub/core",
        "build:scraper": "npm run build --workspace=scraper-node --if-present",
        "build:app": "npm run build --workspace=telegram-ui-app",
        "start": "npm run start:hub",
        "start:hub": "npm run start --workspace=telegram-ui-app -- ./config.json",
        "start:node": "npm run start --workspace=scraper-node -- ./config.json",
        "start:docker": "docker compose up --build",
        "stop:docker": "docker compose down",
        "test": "npm run test --workspaces --if-present",
        "test:e2e": "jest --config jest.config.e2e.js"
    },
    "devDependencies": {
        "@swc/core": "^1.10.18",
        "@swc/helpers": "^0.5.15"
    }
}
