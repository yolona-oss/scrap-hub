# Example environment for a scraper-node container.
# Copy to .env (git-ignored) and fill in real values.

# Unique id for this node (UUID). Obtained from the hub operator via
#   docker compose run --rm cmd-hub cmd-hub node-add <name>
NODE_ID=REPLACE_ME

# Human-readable name that shows up in /node list.
NODE_NAME=scraper-node

# Bearer token the node presents on Register. Keep this secret; rotate via
#   cmd-hub node-rotate-token <id>
NODE_TOKEN=REPLACE_ME

# Hub gRPC address.
HUB_ADDRESS=cmd-hub:50051

# Shared MongoDB.
MONGO_URL=mongodb://mongo:27017/cmdhub?replicaSet=rs0

# Address the node itself listens on for inbound Invoke calls from the hub.
NODE_LISTEN_BIND_ADDRESS=0.0.0.0:50052

# SHA-256 fingerprint of this node's TLS cert. Only required when the hub
# runs without mTLS (e.g. dev compose stack); with mTLS enabled, the hub
# reads the peer cert fingerprint from the TLS session instead.
NODE_CERT_FINGERPRINT=
