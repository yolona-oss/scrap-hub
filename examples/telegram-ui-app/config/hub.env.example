# Example environment for the telegram-ui-app container.
# Copy to .env (git-ignored) and fill in real values.

# MongoDB (replica set required for transactions).
MONGO_URL=mongodb://mongo:27017/cmdhub?replicaSet=rs0

# Hub gRPC listen address — nodes dial this to Register / Heartbeat.
HUB_GRPC_BIND_ADDRESS=0.0.0.0:50051

# Publicly reachable base URL for the hub (used as the hub-side uploadUrl
# prefix for FileService capability grants). Inside a docker network this is
# the container name + upload HTTP port.
HUB_PUBLIC_BASE_URL=http://cmd-hub:3000

# HTTP port the hub binds for /upload.
HUB_UPLOAD_HTTP_PORT=3000

# If true, nodes are ACTIVE immediately on successful Register. If false,
# admin must run /node approve <id> before the node is routable.
AUTH_AUTO_REGISTER=true

# Telegram bot token (from @BotFather).
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Comma-separated Telegram user IDs that get /config /sconfig /node admin access.
TELEGRAM_ADMIN_USER_IDS=

# Optional outbound proxy for Telegram API (if the host can't reach api.telegram.org).
# ALL_PROXY=socks5://proxy:1080
# HTTPS_PROXY=http://proxy:3128
