{
    "extends": "../../tsconfig.base.json",

    "compilerOptions": {
        "outDir": "./build",
        "baseUrl": "./",
        "declaration": false,
        "paths": {
            "@core/*":  ["../../packages/cmd-hub/src/*"],
            "@logger":  ["../../packages/cmd-hub/src/application/logger"],
            "@config":  ["../../packages/cmd-hub/src/config"],
            "@utils/*": ["../../packages/cmd-hub/src/utils/*"]
        }
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "node_modules",
        "build"
    ]
}
