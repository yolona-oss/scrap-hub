{
    "extends": "../../tsconfig.base.json",

    "compilerOptions": {
        "outDir": "./build",
        "baseUrl": "./",
        "declaration": false,
        "paths": {
            "@core/*":    ["../cmd-hub/src/*"],
            "@logger":    ["../cmd-hub/src/application/logger"],
            "@config":    ["./src/config"],
            "@utils/*":   ["../cmd-hub/src/utils/*"]
        }
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
