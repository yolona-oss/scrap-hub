# Get these values from your hub operator:
#   docker compose exec cmd-hub node packages/cmd-hub/build/src/cli/cmd-hub-cli.js node-add <name> --auto-activate
NODE_ID=
NODE_TOKEN=

# Where the hub lives.
HUB_ADDRESS=localhost:50051

# Where this node listens for Invoke requests from the hub.
NODE_LISTEN_BIND_ADDRESS=0.0.0.0:50052

# Only needed when the hub runs WITHOUT mTLS (e.g. dev compose). With mTLS
# the hub reads the peer cert fingerprint from the TLS session.
NODE_CERT_FINGERPRINT=
