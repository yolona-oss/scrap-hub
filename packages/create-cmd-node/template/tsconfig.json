{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "lib": ["es2022"],
        "outDir": "./build",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules", "build"]
}
